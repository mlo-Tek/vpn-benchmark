<?xml version="1.0"?>
<Container version="2">
  <Name>vpn-benchmark</Name>
  <Repository>ghcr.io/mlo-tek/vpn-benchmark:latest</Repository>
  <Registry>https://github.com/mlo-Tek/vpn-benchmark/pkgs/container/vpn-benchmark</Registry>
  <Network>bridge</Network>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/mlo-Tek/vpn-benchmark</Support>
  <Overview>Tests and compares many WireGuard configs: latency/loss to the countries where your torrent peers live, peer-swarm connect rate, handshake, MTU and throughput.</Overview>
  <Category>Network:Other Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <ExtraParams>--cap-add=NET_ADMIN --cap-add=SYS_ADMIN --device=/dev/net/tun</ExtraParams>
  <Config Name="WebUI Port" Target="8080" Default="8080" Mode="tcp" Description="Web UI" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="WireGuard configs" Target="/configs" Default="/mnt/user/appdata/vpn-benchmark/configs" Mode="ro" Description="Folder with your .conf files" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/vpn-benchmark/configs</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/vpn-benchmark/data" Mode="rw" Description="Results database, optional targets.yaml override" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/vpn-benchmark/data</Config>
</Container>
