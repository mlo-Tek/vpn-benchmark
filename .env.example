# Copy to .env and edit as needed. NEVER commit .env.
TZ=Europe/Berlin
PUID=1000
PGID=1000
VPN_BENCHMARK_BIND=127.0.0.1
VPN_BENCHMARK_PORT=8765

# Optional. Both values must be set together.
# Basic Auth is NOT a substitute for TLS or a private network.
VPN_BENCHMARK_USER=
VPN_BENCHMARK_PASSWORD=

# Optional read-only GitHub token for update checks on private repositories.
GITHUB_TOKEN=
